# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server)
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
# Public URL of the frontend, used in password-reset / set-password links
APP_URL=http://localhost:8443
# Set when running behind a reverse proxy so req.ip and rate limits use the client IP
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgresql://tuition:tuition@localhost:5433/tuition?schema=public

# --- Sessions ---
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# --- Initial teacher/admin account (used by `npm run db:seed`) ---
ADMIN_EMAIL=teacher@srikrishnaphysics.in
ADMIN_PASSWORD=change-me-please-123
ADMIN_NAME=SriKrishna Mondal

# --- Email (leave SMTP_HOST empty to log emails to the console in development) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SriKrishna Physics Academy <fees@srikrishnaphysics.in>"

# --- Payments ---
# razorpay | mock   (mock is refused when NODE_ENV=production)
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Secret used by the mock provider to sign simulated checkouts / webhooks
MOCK_PAYMENT_SECRET=mock-dev-secret

# --- Background jobs (monthly charge generation + reminder emails) ---
SCHEDULER_ENABLED=true
